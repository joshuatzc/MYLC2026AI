# Telegram — Night Games bot (church-building game)
TELEGRAM_BOT_TOKEN=your_night_bot_token_here

# Telegram — Day Bot (ice breaker scorer, separate bot token from @BotFather)
DAY_BOT_TOKEN=your_day_bot_token_here

# Leader auth
LEADER_PASSWORD=letmein

# Database (SQLite default; swap for postgres+asyncpg URL for production)
DATABASE_URL=sqlite+aiosqlite:///./church_game.db

# FastAPI
API_HOST=0.0.0.0
API_PORT=8000
SECRET_KEY=change-me-in-production
BASE_URL=https://your-bot-domain.com

# Game defaults
STARTING_POPULATION=10

# Gemini & AI News
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite

